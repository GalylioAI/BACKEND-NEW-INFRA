# ============================================================
# SECURITY-CRITICAL - generate unique values for each deploy
# ============================================================

# Shared secret for internal service-to-service calls.
# Generate: openssl rand -hex 32
INTERNAL_SECRET=

# Redis password.
# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# ============================================================
# DATABASE PASSWORDS - one per service
# ============================================================

AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
OTP_DB_PASSWORD=
FAVORITES_DB_PASSWORD=
ALERTS_DB_PASSWORD=

# ============================================================
# JWT CONFIGURATION
# ============================================================

# Must match across api-gateway and auth-service.
JWT_ISSUER=your-app-name
JWT_AUDIENCE=your-app-client

# Paths inside containers after Docker secret mount.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
RS256_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=720h

# ============================================================
# COOKIE CONFIGURATION
# ============================================================

# Use a leading dot for subdomain sharing in production.
COOKIE_DOMAIN=.yourdomain.com
COOKIE_SECURE=true

# ============================================================
# GOOGLE OAUTH
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# CORS
# ============================================================

# Comma-separated, no trailing slash, no wildcard in production.
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ============================================================
# RABBITMQ
# ============================================================

RABBITMQ_USER=rmquser
RABBITMQ_PASSWORD=
RABBITMQ_ERLANG_COOKIE=
RABBITMQ_URL=amqp://rmquser:change-me@rabbitmq:5672/

# ============================================================
# REDIS
# ============================================================

GATEWAY_REDIS_URL=redis://:change-me@redis:6379/0
MAIL_REDIS_URL=redis://:change-me@redis:6379/1

# ============================================================
# MAIL
# ============================================================

MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
MAIL_FROM=noreply@yourdomain.com
APP_NAME=Your App

# ============================================================
# SERVICE PORTS (internal except gateway in production)
# ============================================================

GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
OTP_SERVICE_PORT=8083
FAVORITES_SERVICE_PORT=8084
ALERTS_SERVICE_PORT=8085
