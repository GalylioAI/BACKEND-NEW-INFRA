APP_PORT=8080
APP_ENV=development
INTERNAL_SECRET=replace-with-a-long-random-shared-secret

RS256_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ISSUER=your-app-name
JWT_AUDIENCE=your-app-client

AUTH_SERVICE_URL=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
OTP_SERVICE_URL=http://otp-service:8083
FAVORITES_SERVICE_URL=http://favorites-service:8084
ALERTS_SERVICE_URL=http://alerts-service:8085

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
