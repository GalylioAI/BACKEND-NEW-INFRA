# ============================================================
# SECURITY-CRITICAL - generate unique values for each deploy
# ============================================================

# Shared secret for internal service-to-service calls.
# Generate: openssl rand -hex 32
INTERNAL_SECRET=

# Redis password.
# Generate: openssl rand -hex 24
REDIS_PASSWORD=

# ============================================================
# DATABASE PASSWORDS - one per service
# ============================================================

AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
OTP_DB_PASSWORD=
FAVORITES_DB_PASSWORD=
ALERTS_DB_PASSWORD=

# ============================================================
# JWT CONFIGURATION
# ============================================================

# Must match across api-gateway and auth-service.
JWT_ISSUER=your-app-name
JWT_AUDIENCE=your-app-client

# Paths inside containers after Docker secret mount.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
RS256_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem

JWT_ACCESS_EXPIRY=15m
JWT_2FA_PENDING_EXPIRY=5m
REFRESH_TOKEN_EXPIRY=720h
JWT_SIGNING_ALGORITHM=RS256

# ============================================================
# COOKIE CONFIGURATION
# ============================================================

# Production 1111.tn uses backend.1111.tn with the refresh cookie scoped to /auth.
COOKIE_DOMAIN=backend.1111.tn
COOKIE_SECURE=true
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_DOMAIN=backend.1111.tn
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_MAX_AGE=720h

# ============================================================
# GOOGLE OAUTH
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ============================================================
# CORS
# ============================================================

# Comma-separated, no trailing slash, no wildcard in production.
CORS_ALLOWED_ORIGINS=https://1111.tn
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-Id,X-Confirm
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600

# ============================================================
# SECURITY CONTROLS
# ============================================================

RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_WINDOW=1m
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_OTP_LIMIT=3
RATE_LIMIT_OTP_WINDOW=1m
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=1m
LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
RECENT_AUTH_WINDOW=10m
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=2
PASSWORD_HASH_SALT_BYTES=16
PASSWORD_HASH_KEY_BYTES=32

# ============================================================
# OTP AND CLEANUP
# ============================================================

EMAIL_VERIFICATION_OTP_EXPIRY=10m
PASSWORD_RESET_OTP_EXPIRY=10m
PASSWORD_RESET_TOKEN_EXPIRY=15m
TWO_FACTOR_LOGIN_OTP_EXPIRY=10m
TWO_FACTOR_ENABLE_OTP_EXPIRY=10m
TWO_FACTOR_DISABLE_OTP_EXPIRY=10m
TOKEN_CLEANUP_INTERVAL=1h
OTP_CLEANUP_INTERVAL=1h
CHALLENGE_CLEANUP_INTERVAL=1h
OUTBOX_CLEANUP_INTERVAL=24h
AUDIT_RETENTION_DAYS=180

# ============================================================
# APP AND SERVER
# ============================================================

APP_ENV=development
BASE_API_URL=https://backend.1111.tn
FRONTEND_URL=https://1111.tn
LOG_LEVEL=debug
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
READ_HEADER_TIMEOUT=5s
IDLE_TIMEOUT=60s
BODY_LIMIT_BYTES=1048576
DB_SSLMODE=disable

# ============================================================
# RABBITMQ
# ============================================================

RABBITMQ_USER=rmquser
RABBITMQ_PASSWORD=
RABBITMQ_ERLANG_COOKIE=
RABBITMQ_URL=amqp://rmquser:change-me@rabbitmq:5672/

# ============================================================
# REDIS
# ============================================================

# Local docker-compose.yml builds REDIS_URL values from REDIS_PASSWORD.
# Production docker-compose.prod.yml uses .env.production.example instead:
#   REDIS_URL_GATEWAY=redis://:<password>@host.docker.internal:6379/0
#   REDIS_URL_MAIL=redis://:<password>@host.docker.internal:6379/1

# ============================================================
# MAIL
# ============================================================

MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
# The MAIL_FROM domain must have valid SPF/DKIM/DMARC DNS records.
# See docs/EMAIL_DELIVERABILITY.md.
MAIL_FROM=noreply@1111.tn
APP_NAME=1111

# ============================================================
# SERVICE PORTS (internal except gateway in production)
# ============================================================

DOCS_ENABLED=true
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
OTP_SERVICE_PORT=8083
FAVORITES_SERVICE_PORT=8084
ALERTS_SERVICE_PORT=8085
