# ============================================================
# SECURITY-CRITICAL - generate unique values for each deploy
# ============================================================

APP_ENV=production
IMAGE_TAG=latest

# Stable Docker network used by app containers to reach host services.
APP_INTERNAL_NETWORK=app_internal
APP_DOCKER_SUBNET=172.18.0.0/16
APP_DOCKER_GATEWAY=172.18.0.1

# Public traffic must enter through Nginx. Keep app ports on localhost.
FRONTEND_BIND_IP=127.0.0.1
GATEWAY_BIND_IP=127.0.0.1

# CIDRs whose X-Forwarded-For header the gateway may trust.
# The deploy workflow overrides this automatically when Nginx is active.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Public API documentation. Set false to disable /docs and /openapi.yaml.
DOCS_ENABLED=true

# Shared secret for internal service-to-service calls
# Generate: openssl rand -hex 32
INTERNAL_SECRET=

# ============================================================
# DOMAIN, CORS, AND COOKIES
# ============================================================

FRONTEND_DOMAIN=1111.tn
BACKEND_DOMAIN=backend.1111.tn
DOMAIN=backend.1111.tn
BASE_API_URL=https://backend.1111.tn
FRONTEND_URL=https://1111.tn
NEXT_PUBLIC_API_BASE_URL=https://backend.1111.tn
NEXT_PUBLIC_APP_URL=https://1111.tn
COOKIE_DOMAIN=backend.1111.tn
COOKIE_SECURE=true
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_DOMAIN=backend.1111.tn
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_MAX_AGE=720h
CORS_ALLOWED_ORIGINS=https://1111.tn
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-Id,X-Confirm
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600

# ============================================================
# DATABASE PASSWORDS
# ============================================================

AUTH_DB_PASSWORD=
USER_DB_PASSWORD=
OTP_DB_PASSWORD=
FAVORITES_DB_PASSWORD=
ALERTS_DB_PASSWORD=

# Direct migration URLs bypass PgBouncer and use host PostgreSQL.
AUTH_DB_MIGRATION_URL=postgres://auth_user:REPLACE_PASSWORD@host.docker.internal:5432/auth_db?sslmode=disable
USER_DB_MIGRATION_URL=postgres://user_user:REPLACE_PASSWORD@host.docker.internal:5432/user_db?sslmode=disable
OTP_DB_MIGRATION_URL=postgres://otp_user:REPLACE_PASSWORD@host.docker.internal:5432/otp_db?sslmode=disable
FAVORITES_DB_MIGRATION_URL=postgres://favorites_user:REPLACE_PASSWORD@host.docker.internal:5432/favorites_db?sslmode=disable
ALERTS_DB_MIGRATION_URL=postgres://alerts_user:REPLACE_PASSWORD@host.docker.internal:5432/alerts_db?sslmode=disable

# ============================================================
# JWT CONFIGURATION
# ============================================================

JWT_ISSUER=your-app-name
JWT_AUDIENCE=your-app-client
JWT_ACCESS_EXPIRY=15m
JWT_2FA_PENDING_EXPIRY=5m
REFRESH_TOKEN_EXPIRY=720h
JWT_SIGNING_ALGORITHM=RS256

# ============================================================
# SECURITY CONTROLS
# ============================================================

RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_WINDOW=1m
RATE_LIMIT_LOGIN_LIMIT=5
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_OTP_LIMIT=3
RATE_LIMIT_OTP_WINDOW=1m
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=1m
LOGIN_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=15m
RECENT_AUTH_WINDOW=10m
PASSWORD_HASH_MEMORY_KIB=65536
PASSWORD_HASH_ITERATIONS=3
PASSWORD_HASH_PARALLELISM=2
PASSWORD_HASH_SALT_BYTES=16
PASSWORD_HASH_KEY_BYTES=32
EMAIL_VERIFICATION_OTP_EXPIRY=10m
PASSWORD_RESET_OTP_EXPIRY=10m
PASSWORD_RESET_TOKEN_EXPIRY=15m
TWO_FACTOR_LOGIN_OTP_EXPIRY=10m
TWO_FACTOR_ENABLE_OTP_EXPIRY=10m
TWO_FACTOR_DISABLE_OTP_EXPIRY=10m
TOKEN_CLEANUP_INTERVAL=1h
OTP_CLEANUP_INTERVAL=1h
CHALLENGE_CLEANUP_INTERVAL=1h
OUTBOX_CLEANUP_INTERVAL=24h
AUDIT_RETENTION_DAYS=180
LOG_LEVEL=info
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
READ_HEADER_TIMEOUT=5s
IDLE_TIMEOUT=60s
BODY_LIMIT_BYTES=1048576
DB_SSLMODE=disable

# ============================================================
# REDIS
# ============================================================

REDIS_PASSWORD=
REDIS_URL_GATEWAY=redis://:REPLACE_WITH_REDIS_PASSWORD@host.docker.internal:6379/0
REDIS_URL_MAIL=redis://:REPLACE_WITH_REDIS_PASSWORD@host.docker.internal:6379/1

# ============================================================
# RABBITMQ
# ============================================================

RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_URL=amqp://RABBITMQ_USER:RABBITMQ_PASSWORD@host.docker.internal:5672/

# ============================================================
# GOOGLE OAUTH
# ============================================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# MAIL
# ============================================================

MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
# The MAIL_FROM domain must have valid SPF/DKIM/DMARC DNS records.
# See docs/EMAIL_DELIVERABILITY.md.
MAIL_FROM=noreply@1111.tn
APP_NAME=1111
