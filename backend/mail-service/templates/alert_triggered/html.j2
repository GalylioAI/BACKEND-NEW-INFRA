<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; background: #f4f4f4; margin: 0; padding: 0;">
  <div style="max-width: 600px; margin: 40px auto; background: #ffffff; border-radius: 8px; padding: 40px;">
    <h2>Product alert</h2>
    <p>Hi {{ full_name }},</p>
    <p>Your {{ alert_type }} alert for {{ product_name }} was triggered.</p>
    {% if threshold is not none %}<p>Threshold: {{ threshold }}</p>{% endif %}
    {% if current_value is not none %}<p>Current value: {{ current_value }}</p>{% endif %}
    {% if product_url %}<p>Open the product in your app to review it.</p>{% endif %}
    <p style="color: #666; font-size: 13px;">If you did not request this, ignore this email.</p>
  </div>
</body>
</html>
